{% extends "base.html.j2" %}
{% block title %}Interview prep · {{ title }}{% endblock %}
{% block content %}
<header class="masthead compact">
  <h1 class="paper-title">Interview prep</h1>
  <p class="tagline">{{ count }} questions, concepts and terms collected over {{ days }} edition{{ "s" if days != 1 }}. Try to answer before you reveal.</p>
</header>

<div class="prep-controls">
  <input type="search" id="prep-search" placeholder="Search…" aria-label="Search">
  <select id="prep-topic" aria-label="Topic">
    <option value="">All topics</option>
    {% for t in topics %}<option>{{ t }}</option>{% endfor %}
  </select>
  <select id="prep-kind" aria-label="Type">
    <option value="">Everything</option>
    {% for k in kinds %}<option>{{ k }}</option>{% endfor %}
  </select>
  <button type="button" id="prep-shuffle">Shuffle</button>
  <label class="toggle"><input type="checkbox" id="prep-hide-known"> Hide ones I know</label>
</div>
<p class="prep-count" id="prep-count" aria-live="polite"></p>
<ol class="prep-list" id="prep-list"></ol>

<script type="application/json" id="prep-data">{{ items_json | safe }}</script>
{% endblock %}
